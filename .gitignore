# =========================================================================
# Atmos — Root Git Ignore
# =========================================================================

# --- Secrets & Environment Variables ---
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!*.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key

# --- Python & Virtual Environments ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.installed.cfg
*.egg

# --- Python Testing & Coverage ---
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.cache/

# --- Node.js & Package Managers ---
node_modules/
frontend/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Next.js Build Outputs ---
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.vercel/
*.tsbuildinfo

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.bak
*~

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --- Logs ---
*.log
logs/
